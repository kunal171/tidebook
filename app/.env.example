# Local development only. Vercel ignores this fallback and requires Upstash.
FAUCET_ALLOW_IN_MEMORY_RATE_LIMIT=false

# Required on Vercel. Local development uses a process-local fallback only.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token
