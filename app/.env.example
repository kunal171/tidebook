# Server-only devnet faucet. Never prefix the secret with NEXT_PUBLIC_ and
# configure these values in Vercel's encrypted environment settings.
FAUCET_AUTHORITY_SECRET_KEY=[64-byte JSON array]
FAUCET_BASE_MINT=FggaZG7eJ5tpr2vmpNMbMCHkWkcw9n2Nhmf54g3wQwGk
FAUCET_QUOTE_MINT=8KRa3QwidV2yZspR3wr4p3eNzq2KtejMbU1tZUgNLdtt
